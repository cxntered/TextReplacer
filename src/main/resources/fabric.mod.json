{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "A mod to visually replace any text.",
	"authors": [
		"cxntered"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/textreplacer",
		"sources": "https://github.com/cxntered/TextReplacer/tree/modern",
		"issues": "https://github.com/cxntered/TextReplacer/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/textreplacer/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "dev.cxntered.textreplacer.TextReplacer"
			}
		],
		"modmenu": [
			"dev.cxntered.textreplacer.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"textreplacer.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabric_loader}",
		"minecraft": "${minecraft}",
		"fabric-language-kotlin": "${fabric_language_kotlin}",
		"yet_another_config_lib_v3": "${yacl}"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/textreplacer"
			}
		}
	}
}